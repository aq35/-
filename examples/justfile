# よく使う Git 操作を 1 コマンドにまとめたタスク定義
# https://github.com/casey/just  （インストール: cargo install just）
#
# backend リポジトリのルートに `justfile` として置いて使う。
# `just` だけで一覧を表示。

default:
    @just --list

# 初回セットアップ（サブモジュール取得）
setup:
    git submodule update --init --recursive

# 最新の main から作業ブランチを作る  例: just start feat/user-search
start branch:
    git fetch origin
    git switch -c {{branch}} origin/main

# マージ済み（リモートで削除済み）のローカルブランチを掃除
tidy:
    git switch main
    git pull
    git fetch --prune
    git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads \
      | awk '$2 == "[gone]" { print $1 }' \
      | xargs -r git branch -D

# スキーマを最新にしてビルド（生成）する
schema-bump:
    git submodule update --remote schema
    git diff --submodule=log -- schema
    cargo build
    @echo ""
    @echo "問題なければ:"
    @echo "  git add schema src/ && git commit -m \"chore(schema): スキーマを $(git -C schema rev-parse --short HEAD) に更新\""

# 本番の状況（最新の本番タグと、まだ本番に出ていない main のコミット）
prod:
    #!/usr/bin/env bash
    set -euo pipefail
    git fetch -q origin --tags
    tag=$(git tag -l 'prod-*' --sort=-refname | head -1)
    echo "本番: $tag ($(git log -1 --format='%h %s' "$tag"))"
    echo "未リリース:"
    git log --oneline "$tag..origin/main"

# 緊急修正: 最新の本番タグから hotfix ブランチを切り、main の修正を運ぶ  例: just hotfix 9f8e7d6
hotfix +shas:
    #!/usr/bin/env bash
    set -euo pipefail
    git fetch -q origin --tags
    tag=$(git tag -l 'prod-*' --sort=-refname | head -1)
    git switch -c "hotfix/$tag" "$tag"
    git cherry-pick -x {{shas}}
    git submodule update --init --recursive   # cherry-pick はサブモジュールの中身を更新しないため
    bash scripts/check-hotfix.sh "$tag"
    echo ""
    echo "問題なければ git push → hotfix 用パイプラインが起動します"
