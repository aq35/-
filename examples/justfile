# よく使う Git 操作を 1 コマンドにまとめたタスク定義
# https://github.com/casey/just  （インストール: cargo install just）
#
# backend リポジトリのルートに `justfile` として置いて使う。
# `just` だけで一覧を表示。

default:
    @just --list

# 初回セットアップ（サブモジュール取得）
setup:
    git submodule update --init --recursive

# 最新の main から作業ブランチを作る  例: just start feat/user-search
start branch:
    git fetch origin
    git switch -c {{branch}} origin/main

# マージ済み（リモートで削除済み）のローカルブランチを掃除
tidy:
    git switch main
    git pull
    git fetch --prune
    git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads \
      | awk '$2 == "[gone]" { print $1 }' \
      | xargs -r git branch -D

# スキーマを最新にしてビルド（生成）する
schema-bump:
    git submodule update --remote schema
    git diff --submodule=log -- schema
    cargo build
    @echo ""
    @echo "問題なければ:"
    @echo "  git add schema src/ && git commit -m \"chore(schema): スキーマを $(git -C schema rev-parse --short HEAD) に更新\""

# リリース系列を切る  例: just release-cut 1.5
release-cut version:
    git fetch origin
    git switch -c release/{{version}} origin/main
    git push -u origin release/{{version}}

# main のコミットを release に運ぶ  例: just pick 1.5 9f8e7d6
pick version +shas:
    git fetch origin
    git switch -c pick/{{version}}/$(git rev-parse --short $(echo {{shas}} | awk '{print $1}')) origin/release/{{version}}
    git cherry-pick -x {{shas}}
    git submodule update --init --recursive  # cherry-pick はサブモジュールの中身を更新しないため
    @echo "push して release/{{version}} 宛てに PR を作成してください"

# main にあって release にまだ無いコミット  例: just missing 1.5
missing version:
    git fetch origin
    git log --oneline --cherry-pick --right-only origin/release/{{version}}...origin/main

# 本番リリース（release/X.Y 上でタグを打って push）  例: just ship v1.5.1
ship tag:
    #!/usr/bin/env bash
    set -euo pipefail
    branch=$(git branch --show-current)
    if [[ "$branch" != release/* ]]; then
      echo "release/* ブランチで実行してください（現在: $branch）"; exit 1
    fi
    if [[ "{{tag}}" != "v${branch#release/}."* ]]; then
      echo "タグ {{tag}} はブランチ $branch と一致しません（例: v${branch#release/}.1）"; exit 1
    fi
    git pull --ff-only
    git tag -a "{{tag}}" -m "Release {{tag}}"
    git push origin "{{tag}}"
    echo "{{tag}} を push しました → 本番デプロイが始まります"
